{
  "name": "genesis",
  "version": "0.1.0",
  "description": "A local Electron app for managing and playing your Sega Genesis game collection",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:renderer && npm run build:main && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "postinstall": "prisma generate --schema src/main/db/schema.prisma",
    "migrate": "prisma migrate dev --schema src/main/db/schema.prisma",
    "generate": "prisma generate --schema src/main/db/schema.prisma",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.8.0",
    "electron": "42.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron-builder": "26.8.1",
    "prisma": "6.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "8.0.10",
    "vite-plugin-electron": "^0.29.0",
    "wait-on": "^8.0.3"
  }
}
